[Unit]
Description=t2: start the evening NSE data job on GitHub (signals follow), instead of waiting for GitHub's late schedule
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/t2/app
EnvironmentFile=/opt/t2/.env
ExecStart=/usr/local/bin/uv run --frozen python -m t2.jobs evening
